#!/bin/sh
# Runs typecheck + tests before a push is allowed, for the developer machine.
#
# Pushing to main IS the deploy here - a push triggers the GitHub Actions
# workflow (.github/workflows/deploy.yml), which builds, tests, and pushes
# the result to the VPS over rsync+SSH. That workflow re-runs these same two
# checks as the actual deploy gate, so this hook is fast local feedback, not
# the only thing standing between a broken commit and production - but it
# still catches most breakage before a push even leaves the laptop.
#
# This file is checked in as the source of truth rather than run by git from
# here. Install with:
#   cp infra/deploy/pre-push-hook-checks .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#
# To push anyway (a genuinely known-broken WIP branch), use `git push --no-verify`.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "pre-push: typecheck..."
pnpm typecheck

echo "pre-push: tests..."
pnpm test

echo "pre-push: ok"
