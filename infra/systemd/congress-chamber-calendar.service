[Unit]
Description=Congress - Calendar Chamber
After=network.target congress-capitol.service

[Service]
Type=simple
User=marin
WorkingDirectory=/srv/congress/services/chamber-calendar
ExecStart=/usr/bin/pnpm run start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
