[Unit]
Description=Congress - core service (registry, gateway, auth, exhibits, sharing)
After=network.target

[Service]
Type=simple
User=marin
WorkingDirectory=/srv/congress/services/congress
ExecStart=/usr/bin/pnpm run start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
