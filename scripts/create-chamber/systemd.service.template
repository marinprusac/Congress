[Unit]
Description=Congress - __CHAMBER_DISPLAY__ Chamber
After=network.target congress-capitol.service

[Service]
Type=simple
User=marin
WorkingDirectory=/srv/congress/services/chamber-__CHAMBER_NAME__
ExecStart=/usr/bin/pnpm run start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
