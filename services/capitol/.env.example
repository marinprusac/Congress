PORT=3000
HOST=127.0.0.1
CONGRESS_INTERNAL_TOKEN=change-me-dev-token
# sha256 hex digest of the master password, e.g.:
#   echo -n 'your passphrase' | sha256sum | cut -d' ' -f1
CONGRESS_MASTER_PASSWORD_HASH=change-me-64-char-sha256-hex-digest
# random string, 32+ chars, used to sign the session cookie, e.g.: openssl rand -hex 32
SESSION_SECRET=change-me-random-32-plus-chars
# Web Push VAPID keypair - optional, Capitol runs fine without these, it just
# can't deliver push notifications to a device until they're set (and that
# device re-enables push in Settings). Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# (run from services/capitol so it resolves the workspace's own web-push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
DB_PATH=./data/capitol.sqlite3
HEARTBEAT_TIMEOUT_MS=90000
HEARTBEAT_SWEEP_INTERVAL_MS=15000
NODE_ENV=development
