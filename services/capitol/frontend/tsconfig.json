{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // sw.ts needs the "webworker" lib (ServiceWorkerGlobalScope, self.clients,
  // ...), which conflicts with this project's own "DOM" lib if both are
  // typechecked together - see that file's own comment. Vite/esbuild still
  // bundles it at build time regardless of this exclusion.
  "exclude": ["src/sw.ts"]
}
