{
  "name": "capitol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build:web": "vite build --config frontend/vite.config.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p frontend/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@congress/shared-types": "workspace:*",
    "@congress/exhibit-ui": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "zod": "^3.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.30.0",
    "react-router-dom": "^7.18.2",
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
