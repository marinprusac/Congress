PORT=8018
HOST=127.0.0.1
CONGRESS_INTERNAL_TOKEN=change-me-dev-token
CAPITOL_URL=http://127.0.0.1:3000
DB_PATH=./data/deputy.sqlite3
HEARTBEAT_INTERVAL_MS=30000
NODE_ENV=development
# Optional - a one-year token from `claude setup-token` (run on any machine
# with a browser, not necessarily this one) authenticates headless runs
# against the owner's Claude subscription instead of metered API billing.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional - set instead of (or in addition to) the token above to use
# isolated, metered Console billing rather than subscription usage.
ANTHROPIC_API_KEY=
