PORT=8016
HOST=127.0.0.1
CONGRESS_INTERNAL_TOKEN=change-me-dev-token
CAPITOL_URL=http://127.0.0.1:3000
DB_PATH=./data/notifications.sqlite3
HEARTBEAT_INTERVAL_MS=30000
NODE_ENV=development
# Web Push VAPID keypair - optional, this Chamber runs fine without these, it
# just can't deliver push notifications to a device until they're set (and
# that device re-enables push in Settings). Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# (run from services/chamber-notifications so it resolves the workspace's
# own web-push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
