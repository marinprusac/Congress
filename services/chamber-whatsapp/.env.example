# Shared by this Chamber (read by Congress) and the wa-reader daemon
# (systemd EnvironmentFile). No secrets live here.

# Unix socket wa-reader serves its read-only API on.
WA_READER_SOCKET=/run/wa-reader/api.sock

# Daemon only. Relative paths resolve against this Chamber's folder.
WA_SESSION_DB=./data/session.sqlite3
WA_MESSAGES_DB=./data/messages.sqlite3
# Largest attachment wa-reader will download on request (bytes).
WA_MEDIA_MAX_BYTES=26214400
# Ask the phone for full history when pairing (only matters at pairing time).
WA_FULL_HISTORY=true
# Label shown in the phone's Linked devices list.
WA_DEVICE_NAME=Congress
# DEBUG | INFO | WARN | ERROR
WA_LOG_LEVEL=INFO
