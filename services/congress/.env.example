PORT=3000
HOST=127.0.0.1
CONGRESS_INTERNAL_TOKEN=change-me-dev-token
# sha256 hex digest of the master password, e.g.:
#   echo -n 'your passphrase' | sha256sum | cut -d' ' -f1
CONGRESS_MASTER_PASSWORD_HASH=change-me-64-char-sha256-hex-digest
# random string, 32+ chars, used to sign the session cookie, e.g.: openssl rand -hex 32
SESSION_SECRET=change-me-random-32-plus-chars
DB_PATH=./data/capitol.sqlite3
NODE_ENV=development

# Web Push (optional) - previously lived in chamber-logs/.env.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# AI engine (ai/engine.ts) - previously lived in chamber-deputy/.env. Both optional:
# a one-year token from `claude setup-token` bills the owner's Claude subscription;
# ANTHROPIC_API_KEY bills metered Console usage instead. With neither set, `claude`
# uses whatever `claude auth login` left for this OS user.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Google connector (connectors/google) - shared by Calendar, Mail, ... Unset falls
# back to ../chamber-calendar/.env (GOOGLE_OAUTH_FALLBACK_ENV_PATH).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/congress/connectors/google/callback
